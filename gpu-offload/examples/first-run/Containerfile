FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /uvx /bin/

ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY gpu-offload/runtime /runtime
RUN uv venv --seed /opt/venv && \
	uv pip install --python /opt/venv/bin/python /runtime

COPY gpu-offload/examples/first-run/client.py /app/client.py
COPY gpu-offload/examples/first-run/demo_model.py /app/demo_model.py

CMD ["python3", "/app/client.py"]
