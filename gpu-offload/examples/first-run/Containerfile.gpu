# Server-stage image for the GPU offload check.
#
# Based on python:3.12-slim rather than an nvidia/cuda image on purpose. The
# CUDA base images set NVIDIA_VISIBLE_DEVICES=all, which makes every container
# see the GPU once the NVIDIA runtime is the containerd default and would
# invalidate the client-sees-no-GPU control. The torch wheels bundle the CUDA
# runtime libraries, so only the host driver is needed.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /uvx /bin/

ARG UV_INDEX_URL
ARG TORCH_VERSION=2.13.0

ENV PATH="/opt/venv/bin:${PATH}"
ENV PYTHONUNBUFFERED=1

WORKDIR /app

COPY runtime /runtime
RUN uv venv --seed /opt/venv && \
	uv pip install --python /opt/venv/bin/python /runtime && \
	uv pip install --python /opt/venv/bin/python "torch==${TORCH_VERSION}"

COPY examples/first-run/client.py /app/client.py
COPY examples/first-run/demo_model.py /app/demo_model.py
COPY examples/first-run/gpu_model.py /app/gpu_model.py

CMD ["python3", "/app/client.py"]
