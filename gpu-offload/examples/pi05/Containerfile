# Client and server-stage image for the pi05 offload example.
#
# One image serves both sides. The remoter imports pi05_policy.py in the control
# container to install the decorators, and lerobot 0.4.3 is an import-time dependency
# of that module's type surface, so the client cannot be slimmed down to a torch-free
# base without diverging from the checkpoint's runtime.
#
# Based on python:3.12-slim rather than an nvidia/cuda image: the CUDA base images set
# NVIDIA_VISIBLE_DEVICES=all, which would hand the control container a GPU it must not
# have. The cu128 torch wheels bundle the CUDA runtime, so only the host driver is needed.
FROM python:3.12-slim

COPY --from=ghcr.io/astral-sh/uv:0.10.9@sha256:10902f58a1606787602f303954cea099626a4adb02acbac4c69920fe9d278f82 /uv /uvx /bin/

ARG UV_INDEX_URL

ENV PATH="/src/examples/pi05/.venv/bin:${PATH}"
ENV PYTHONPATH=/src/examples/pi05
ENV PYTHONUNBUFFERED=1
# Seed the environment so packages that still shell out to pip resolve it.
ENV UV_VENV_SEED=1
# The build task bind-mounts the host uv cache here so the multi-gigabyte cu128
# wheels download once per machine instead of once per build. Copy instead of
# hardlink: the cache and the venv live on different mounts during the build.
ENV UV_CACHE_DIR=/root/.cache/uv
ENV UV_LINK_MODE=copy
# The checkpoint and the PaliGemma tokenizer are mounted read-only; never reach out.
ENV HF_HUB_OFFLINE=1

# opencv-python links against libGL and glib; the slim base ships neither.
RUN apt-get update && \
	apt-get install --yes --no-install-recommends libgl1 libglib2.0-0 && \
	rm -rf /var/lib/apt/lists/*

# The lock resolves xavier-remoter-runtime through the relative path ../../runtime,
# so the repository layout must be preserved inside the image.
COPY runtime /src/runtime
COPY examples/pi05/pyproject.toml examples/pi05/uv.lock /src/examples/pi05/

WORKDIR /src/examples/pi05

RUN uv sync --frozen --no-install-project

COPY examples/pi05/pi05_policy.py examples/pi05/run_pi05.py examples/pi05/ur10e_bridge.py /src/examples/pi05/

CMD ["python3", "/src/examples/pi05/run_pi05.py"]
